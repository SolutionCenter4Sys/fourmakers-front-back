# Environment variables (templates com sufixo podem existir — não versionar valores reais)
.env
.env.local
.env.*.local
.env.*
!.env.example

# Credenciais Git (arquivo de referência fica no Desktop; não versionar)
*git*credentials*.txt

# Editor directories and files
!.vscode/extensions.json
.vscode/chrome-debug-profile/
.idea
.cursor/backup/
# .cursor/agents/ — descomente para não versionar; comentado para versionar prompts de agents
