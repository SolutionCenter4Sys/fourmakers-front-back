.cursor/agents/MR-agent.md
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# local tests (only ignore test output, not test source files)
*.test.js
*.test.js.map
*.spec.js
*.spec.js.map
vitest.*
coverage/
.nyc_output/

# Ignore IMPLEMENTATION assets
IMPLEMENTATION/

# PBI (documento fora do versionamento)
PBI-Metricas-Board-Contratacao.md
code-review*
.cursor/backup/*
# Backup temporário de arquivos movidos antes de merge (não versionar)
.merge-backup/

# Artefatos temporários de fluxos Git automatizados (agregação/relatórios)
.aggregation_backup
aggregation.log
FILE_AGGREGATION_MANIFEST.txt
FILE_AGGREGATION_REPORT.md
STAGED_FILES.txt
commit_message.txt
