## 2. Anemic UseCases

**Context:** When reviewing UseCase implementations. UseCases should represent business intent and contain logic, not just pass through.

**Forbidden:**

```typescript
// ❌ BAD: Anemic UseCase - just passes through
// src/domain/usecases/vaga/ListarVagasUseCase.ts
@injectable()
export class ListarVagasUseCase {
  constructor(
    @inject('VagaRepository') private repo: VagaRepository
  ) {}
  
  async execute(): Promise<Vaga[]> {
    // Just delegates - adds no value!
    return this.repo.listar();
  }
}

// ❌ BAD: Anemic UseCase with no decision
// src/domain/usecases/candidatura/AprovarCandidatoUseCase.ts
@injectable()
export class AprovarCandidatoUseCase {
  constructor(
    @inject('CandidaturaRepository') private repo: CandidaturaRepository
  ) {}
  
  async execute(candidatoId: string): Promise<void> {
    // No validation, no orchestration, just pass-through
    await this.repo.atualizarStatus(candidatoId, 'APROVADO');
  }
}
```

**Required:**

```typescript
// ✅ GOOD: Rich UseCase with intent and logic
// src/domain/usecases/vaga/ListarVagasUseCase.ts
@injectable()
export class ListarVagasUseCase {
  constructor(
    @inject('VagaRepository') private repo: VagaRepository,
    @inject('CacheService') private cache: CacheService,
    @inject('Logger') private logger: Logger
  ) {}
  
  async execute(filtro: FiltroVaga): Promise<Vaga[]> {
    const cacheKey = `vagas:${JSON.stringify(filtro)}`;
    
    // Decision: Check cache first
    const cached = this.cache.get<Vaga[]>(cacheKey);
    if (cached && this.cacheAindaValido(filtro)) {
      this.logger.debug('Cache hit for vagas list', { filtro });
      return cached;
    }
    
    // Get from repository
    const vagas = await this.repo.listar(filtro);
    
    // Decision: Apply post-fetch business filter
    const vagasVisiveis = vagas.filter(v => 
      v.estaAtiva() || this.usuarioPodeVerInativas()
    );
    
    // Decision: Sort by business priority
    const ordenadas = this.ordenarPorPrioridade(vagasVisiveis);
    
    // Store in cache
    this.cache.set(cacheKey, ordenadas, 300);
    
    return ordenadas;
  }
  
  private cacheAindaValido(filtro: FiltroVaga): boolean {
    // Business rule: certain filters don't use cache
    return !filtro.ordenacaoPersonalizada;
  }
  
  private usuarioPodeVerInativas(): boolean {
    // Business rule based on current user permissions
    return false; // Simplified
  }
  
  private ordenarPorPrioridade(vagas: Vaga[]): Vaga[] {
    return vagas.sort((a, b) => {
      if (a.destaque && !b.destaque) return -1;
      if (!a.destaque && b.destaque) return 1;
      return b.dataPublicacao.getTime() - a.dataPublicacao.getTime();
    });
  }
}

// ✅ GOOD: UseCase with orchestration
// src/domain/usecases/candidatura/AprovarCandidatoUseCase.ts
@injectable()
export class AprovarCandidatoUseCase {
  constructor(
    @inject('CandidaturaRepository') private candidaturaRepo: CandidaturaRepository,
    @inject('VagaRepository') private vagaRepo: VagaRepository,
    @inject('NotificacaoService') private notificacao: NotificacaoService,
    @inject('AuditoriaService') private auditoria: AuditoriaService,
    @inject('Logger') private logger: Logger
  ) {}
  
  async execute(candidatoId: string): Promise<Resultado<void>> {
    this.logger.info('Iniciando aprovacao de candidato', { candidatoId });
    
    // Step 1: Load with validation
    const candidatura = await this.candidaturaRepo.obterPorId(candidatoId);
    if (!candidatura) {
      this.logger.warn('Candidato nao encontrado', { candidatoId });
      return { sucesso: false, erro: 'Candidato nao encontrado' };
    }
    
    // Step 2: Business validation
    if (candidatura.status !== 'EM_ANALISE') {
      return { 
        sucesso: false, 
        erro: `Nao e possivel aprovar candidato com status ${candidatura.status}` 
      };
    }
    
    // Step 3: Load related data
    const vaga = await this.vagaRepo.obterPorId(candidatura.vagaId);
    if (!vaga) {
      return { sucesso: false, erro: 'Vaga associada nao encontrada' };
    }
    
    // Step 4: Execute business operation
    candidatura.aprovar();
    await this.candidaturaRepo.salvar(candidatura);
    
    // Step 5: Side effects
    await Promise.all([
      this.notificacao.enviar(candidatura.candidatoEmail, 'APROVACAO', {
        vagaTitulo: vaga.titulo,
        proximosPassos: 'Aguarde contato do RH'
      }),
      this.auditoria.registrar('CANDIDATURA_APROVADA', {
        candidatoId,
        vagaId: vaga.id,
        aprovadorId: this.getUsuarioAtual()
      })
    ]);
    
    this.logger.info('Candidato aprovado com sucesso', { candidatoId });
    return { sucesso: true };
  }
}
```

**UseCase Health Indicators:**

| Anemic (Bad) | Rich (Good) |
|--------------|-------------|
| < 5 lines of code | Substantial logic |
| Just calls repo | Makes decisions |
| No validation | Validates input |
| No orchestration | Coordinates multiple services |
| No side effects | Handles notifications, audit, cache |
| No error handling | Comprehensive error handling |

**Impact:**

- Inflated architecture - extra layers with no purpose
- Layers without purpose - indirection without value
- Confusion - developers don't know what UseCases are for

**Detection:**

- UseCases that just call `repo.listar()`
- UseCases without `if/else` or validation
- UseCases without error handling
- UseCases that don't inject any services beyond repository

**When UseCase is Justified:**

- Orchestrates multiple repositories
- Applies business filters/sorting
- Handles caching
- Sends notifications
- Records audit
- Validates preconditions

**When Query is Sufficient:**

- Simple list with no filters
- Direct lookup by ID
- No side effects needed
- Consider using Repository directly or Query Handler pattern

