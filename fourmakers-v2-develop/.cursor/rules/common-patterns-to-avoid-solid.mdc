## 4. Interface Segregation Violations

**Context:** When interfaces are too large, forcing implementations to depend on methods they don't need.

**Forbidden:**

```typescript
// ❌ BAD: Fat interface
// src/domain/repositories/Repository.ts
export interface Repository<T> {
  criar(dados: T): Promise<T>;
  obterPorId(id: string): Promise<T | null>;
  listar(): Promise<T[]>;
  atualizar(id: string, dados: T): Promise<T>;
  deletar(id: string): Promise<void>;
  buscar(filtro: Filtro): Promise<T[]>;
  contar(): Promise<number>;
  paginar(pagina: number, tamanho: number): Promise<Pagina<T>>;
  ordenar(campo: string, direcao: 'asc' | 'desc'): Promise<T[]>;
  exportar(): Promise<Buffer>;
  importar(dados: Buffer): Promise<void>;
}

// ❌ BAD: Implementation forced to implement unused methods
export class VagaRepositoryImpl implements Repository<Vaga> {
  // Must implement all, even if not needed
  async exportar(): Promise<Buffer> {
    throw new Error('Not implemented'); // Dead code!
  }
  
  async importar(): Promise<void> {
    throw new Error('Not implemented'); // Dead code!
  }
}
```

**Required:**

```typescript
// ✅ GOOD: Segregated interfaces
// src/domain/repositories/CrudRepository.ts
export interface CrudRepository<T> {
  criar(dados: T): Promise<T>;
  obterPorId(id: string): Promise<T | null>;
  listar(): Promise<T[]>;
  atualizar(id: string, dados: T): Promise<T>;
  deletar(id: string): Promise<void>;
}

// src/domain/repositories/QueryableRepository.ts
export interface QueryableRepository<T> {
  buscar(filtro: Filtro): Promise<T[]>;
  paginar(pagina: number, tamanho: number): Promise<Pagina<T>>;
  ordenar(campo: string, direcao: 'asc' | 'desc'): Promise<T[]>;
  contar(): Promise<number>;
}

// src/domain/repositories/ExportableRepository.ts
export interface ExportableRepository<T> {
  exportar(): Promise<Buffer>;
  importar(dados: Buffer): Promise<void>;
}

// ✅ GOOD: Implementation implements only what it needs
@injectable()
export class VagaRepositoryImpl 
  implements CrudRepository<Vaga>, QueryableRepository<Vaga> {
  // Only implements methods that make sense for Vaga
  async criar(dados: Vaga): Promise<Vaga> { /* ... */ }
  async obterPorId(id: string): Promise<Vaga | null> { /* ... */ }
  // ... etc
}

// ✅ GOOD: UseCase depends on minimal interface
@injectable()
export class ListarVagasUseCase {
  constructor(
    @inject('VagaRepository') 
    private repo: QueryableRepository<Vaga> // Only needs query methods
  ) {}
}

@injectable()
export class CriarVagaUseCase {
  constructor(
    @inject('VagaRepository') 
    private repo: CrudRepository<Vaga> // Only needs CRUD methods
  ) {}
}
```

**Impact:**

- Low cohesion - interfaces mix unrelated responsibilities
- Implementation burden - must implement unused methods
- Testing overhead - more methods to mock
- Interface pollution - hard to understand what methods are actually used

**Detection:**

- Interfaces with > 5 methods
- `throw new Error('Not implemented')` in implementations
- Comments like "not used" or "placeholder" in implementations
- Methods that return null/undefined always

