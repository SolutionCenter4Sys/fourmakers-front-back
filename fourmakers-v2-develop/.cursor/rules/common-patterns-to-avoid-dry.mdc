# DRY (Don't Repeat Yourself) Anti-Patterns

Duplication of code, logic, or knowledge across the codebase.

---

## 1. Code or Rule Duplication

**Context:** When the same logic appears in multiple places. Not just copying code — it's duplicating decision logic that will diverge over time.

**Forbidden:**

```typescript
// ❌ BAD: Repeated error handling
// src/data/api/CandidaturaApi.ts
async function listarCandidaturas() {
  try {
    const response = await httpClient.get('/api/candidaturas');
    return response.data;
  } catch (error) {
    if (error.response?.status === 401) {
      console.error('Sessao expirada');
      window.location.href = '/login';
    } else if (error.response?.status >= 500) {
      console.error('Erro no servidor');
    } else {
      console.error('Erro desconhecido', error);
    }
    throw error;
  }
}

// ❌ BAD: Same error handling repeated
// src/data/api/VagaApi.ts
async function listarVagas() {
  try {
    const response = await httpClient.get('/api/vagas');
    return response.data;
  } catch (error) {
    // EXACT same error handling as above!
    if (error.response?.status === 401) {
      console.error('Sessao expirada');
      window.location.href = '/login';
    } else if (error.response?.status >= 500) {
      console.error('Erro no servidor');
    } else {
      console.error('Erro desconhecido', error);
    }
    throw error;
  }
}

// ❌ BAD: Copy-pasted validation
// src/presentation/components/vaga/CriarVagaModal.tsx
const validar = (dados: VagaForm) => {
  const erros: string[] = [];
  if (!dados.titulo || dados.titulo.length < 5) {
    erros.push('Titulo deve ter pelo menos 5 caracteres');
  }
  if (!dados.descricao) {
    erros.push('Descricao e obrigatoria');
  }
  if (dados.salario && dados.salario < 0) {
    erros.push('Salario nao pode ser negativo');
  }
  return erros;
};

// ❌ BAD: Same validation in another component
// src/presentation/pages/EditarVaga.tsx
const validar = (dados: VagaForm) => {
  const erros: string[] = [];
  if (!dados.titulo || dados.titulo.length < 5) {
    erros.push('Titulo deve ter pelo menos 5 caracteres');
  }
  if (!dados.descricao) {
    erros.push('Descricao e obrigatoria');
  }
  if (dados.salario && dados.salario < 0) {
    erros.push('Salario nao pode ser negativo');
  }
  return erros;
};
```

**Required:**

```typescript
// ✅ GOOD: Centralized error handling
// src/data/api/errorHandler.ts
export class ApiErrorHandler {
  static handle(error: AxiosError): never {
    if (error.response?.status === 401) {
      console.error('Sessao expirada');
      window.location.href = '/login';
    } else if (error.response?.status >= 500) {
      console.error('Erro no servidor');
    } else {
      console.error('Erro na requisicao', error);
    }
    throw error;
  }
}

// ✅ GOOD: All APIs use centralized handler
// src/data/api/CandidaturaApi.ts
import { ApiErrorHandler } from './errorHandler';

export const candidaturaApi = {
  async listar(): Promise<Candidatura[]> {
    try {
      const response = await httpClient.get('/api/candidaturas');
      return response.data.retorno;
    } catch (error) {
      ApiErrorHandler.handle(error as AxiosError);
    }
  }
};

// src/data/api/VagaApi.ts
export const vagaApi = {
  async listar(): Promise<Vaga[]> {
    try {
      const response = await httpClient.get('/api/vagas');
      return response.data.retorno;
    } catch (error) {
      ApiErrorHandler.handle(error as AxiosError);
    }
  }
};

// ✅ GOOD: Centralized validation in domain
// src/domain/validators/VagaValidator.ts
@injectable()
export class VagaValidator {
  validar(dados: VagaForm): ValidacaoResult {
    const erros: string[] = [];
    
    if (!dados.titulo || dados.titulo.length < 5) {
      erros.push('Titulo deve ter pelo menos 5 caracteres');
    }
    if (!dados.descricao) {
      erros.push('Descricao e obrigatoria');
    }
    if (dados.salario !== undefined && dados.salario < 0) {
      erros.push('Salario nao pode ser negativo');
    }
    
    return {
      valido: erros.length === 0,
      erros
    };
  }
}

// ✅ GOOD: UseCase uses centralized validator
// src/domain/usecases/vaga/CriarVagaUseCase.ts
@injectable()
export class CriarVagaUseCase {
  constructor(
    @inject('VagaRepository') private repo: VagaRepository,
    @inject('VagaValidator') private validator: VagaValidator
  ) {}
  
  async execute(dados: CriarVagaDTO): Promise<Resultado<Vaga>> {
    const validacao = this.validator.validar(dados);
    if (!validacao.valido) {
      return { sucesso: false, erros: validacao.erros };
    }
    
    const vaga = await this.repo.criar(dados);
    return { sucesso: true, dados: vaga };
  }
}
```

**Common Duplications to Extract:**

| Duplication | Extract To |
|-------------|------------|
| Error handling | `data/api/errorHandler.ts` |
| API response mapping | `data/mappers/` |
| Validation logic | `domain/validators/` |
| Header construction | `data/api/httpClient.ts` |
| Date formatting | `shared/utils/dateUtils.ts` |
| Currency formatting | `shared/utils/currencyUtils.ts` |
| Status labels | `shared/constants/statusLabels.ts` |

**Impact:**

- Future divergence - one place changes, others don't
- Complex maintenance - need to update N places instead of 1
- Inconsistency - different versions of "same" logic
- Bug multiplication - bug exists in every copy

**Detection:**

- Similar `catch` blocks across API files
- Same validation functions in multiple components
- Manual header construction: `headers: { Authorization: ... }` repeated
- Copy-pasted mapping logic
- Same error messages hardcoded in multiple places

**Duplication vs. Coincidence:**

| Duplication (DRY violation) | Coincidence (OK to repeat) |
|-----------------------------|---------------------------|
| Error handling strategy | Specific error messages |
| Validation rules | Form field order |
| API envelope structure | Component layout |
| Data transformation | Styling values |

