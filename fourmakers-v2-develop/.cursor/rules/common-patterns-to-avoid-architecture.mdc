## 5. Decorative Layers

**Context:** When reviewing architecture health. Having folder structure doesn't mean architecture is being followed.

**Signs of Decorative Architecture:**

```typescript
// ❌ BAD: UseCase without business logic
// src/domain/usecases/vaga/ListarVagasUseCase.ts
@injectable()
export class ListarVagasUseCase {
  constructor(
    @inject('VagaRepository') private repository: VagaRepository
  ) {}
  
  async execute(): Promise<Vaga[]> {
    // Just passes through - adds no value
    return this.repository.listar();
  }
}

// ❌ BAD: Domain that doesn't protect rules
// src/domain/entities/Vaga.ts
export interface Vaga {
  id: string;
  titulo: string;
  // No methods, no encapsulation, no validation
}

// ❌ BAD: Repository as pass-through
// src/data/repositories/VagaRepositoryImpl.ts
async listar(): Promise<Vaga[]> {
  // No mapping, no error handling, just direct API call
  return this.api.listar();
}
```

**Required:**

```typescript
// ✅ GOOD: Rich UseCase
// src/domain/usecases/vaga/ListarVagasUseCase.ts
@injectable()
export class ListarVagasUseCase {
  constructor(
    @inject('VagaRepository') private repository: VagaRepository,
    @inject('CacheService') private cache: CacheService
  ) {}
  
  async execute(filtro: FiltroVaga): Promise<Vaga[]> {
    // Check cache first
    const cached = this.cache.get<Vaga[]>(`vagas:${JSON.stringify(filtro)}`);
    if (cached) return cached;
    
    // Get from repository
    const vagas = await this.repository.listar(filtro);
    
    // Apply business filter (not just data filter)
    const vagasAtivas = vagas.filter(v => this.estaAtiva(v));
    
    // Cache result
    this.cache.set(`vagas:${JSON.stringify(filtro)}`, vagasAtivas, 300);
    
    return vagasAtivas;
  }
  
  private estaAtiva(vaga: Vaga): boolean {
    // Business rule: vaga ativa if not expired and has openings
    return !vaga.dataExpiracao || new Date(vaga.dataExpiracao) > new Date();
  }
}

// ✅ GOOD: Rich Entity
// src/domain/entities/Vaga.ts
export class Vaga {
  constructor(
    private readonly _id: string,
    private _titulo: string,
    private _status: StatusVaga,
    private _dataExpiracao?: Date
  ) {}
  
  get id(): string { return this._id; }
  get titulo(): string { return this._titulo; }
  get status(): StatusVaga { return this._status; }
  
  estaAtiva(): boolean {
    // Encapsulated business rule
    if (this._status !== 'PUBLICADA') return false;
    if (!this._dataExpiracao) return true;
    return this._dataExpiracao > new Date();
  }
  
  publicar(): void {
    if (this._status !== 'RASCUNHO') {
      throw new DomainError('Apenas rascunhos podem ser publicados');
    }
    this._status = 'PUBLICADA';
  }
}

// ✅ GOOD: Repository with mapping and error handling
// src/data/repositories/VagaRepositoryImpl.ts
async listar(filtro: FiltroVaga): Promise<Vaga[]> {
  try {
    const response = await this.api.listar({
      pagina: filtro.pagina,
      tamanhoPagina: filtro.itensPorPagina
    });
    
    return response.retorno.map(this.mapToDomain);
  } catch (error) {
    this.logger.error('Failed to list vagas', { error, filtro });
    throw new RepositoryError('Nao foi possivel carregar vagas');
  }
}
```

**Impact:**

- False sense of quality - folders look good, code isn't
- Complexity without benefit - layers exist but add no value
- Maintenance burden - extra indirection without purpose

**Detection:**

- UseCases with < 5 lines of code (just pass-through)
- Entities with no methods (interfaces instead of classes)
- Repositories with no mapping, no error handling
- Services with no logic (just aggregate calls)

**Health Check Questions:**

- Does removing this layer break anything meaningful?
- Is this layer enforcing rules or just passing data?
- Would the code work the same without this abstraction?

