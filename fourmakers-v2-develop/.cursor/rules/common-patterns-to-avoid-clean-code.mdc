## 2. Business Logic in Components

**Context:** When reviewing React components. Components should handle UI, not business decisions.

**Forbidden:**

```typescript
// ❌ BAD: Business calculation in component
// src/presentation/components/feedback/FeedbackCard.tsx
const FeedbackCard = ({ feedback }) => {
  // Business calculation that should be in domain
  const calcularNivel = (comentario: string): number => {
    if (comentario.includes('excelente')) return 5;
    if (comentario.includes('bom')) return 4;
    return 3;
  };
  
  const nivel = calcularNivel(feedback.comentario);
  
  // Business decision in component
  const podeEditar = (feedback) => {
    const diffDays = (new Date() - new Date(feedback.dataCriacao)) / (1000 * 60 * 60 * 24);
    return diffDays < 7 && feedback.status === 'RASCUNHO';
  };

  return <Card>{/* ... */}</Card>;
};

// ❌ BAD: Orchestration in component
// src/presentation/pages/recrutamento/GestaoVagas.tsx
const GestaoVagasPage = () => {
  const handleAprovarCandidato = async (candidato) => {
    // Business validation mixed with UI
    if (candidato.status !== 'EM_ANALISE') {
      toast.error('Somente candidatos em analise podem ser aprovados');
      return;
    }
    
    // Complex business flow
    await candidaturaApi.atualizarStatus(candidato.id, 'APROVADO');
    await notificacaoApi.enviar(candidato.email, 'Parabens! Voce foi aprovado');
    await auditoriaApi.registrar('APROVACAO_CANDIDATO', candidato.id);
    
    // ... more business logic
  };
};
```

**Required:**

```typescript
// ✅ GOOD: Component delegates to UseCase
// src/presentation/components/feedback/FeedbackCard.tsx
const FeedbackCard = ({ feedback }: FeedbackCardProps) => {
  // Component only handles UI concerns
  const container = useContainer();
  const calcularNivelUseCase = container.resolve(CalcularNivelUseCase);
  const verificarEdicaoUseCase = container.resolve(VerificarEdicaoUseCase);
  
  const nivel = useMemo(() => 
    calcularNivelUseCase.execute(feedback.comentario),
    [feedback.comentario]
  );
  
  const podeEditar = useMemo(() => 
    verificarEdicaoUseCase.execute(feedback),
    [feedback]
  );
  
  return (
    <Card>
      <NivelBadge nivel={nivel} />
      {podeEditar && <EditButton />}
    </Card>
  );
};

// ✅ GOOD: Page delegates complex flow to UseCase
// src/domain/usecases/candidatura/AprovarCandidatoUseCase.ts
@injectable()
export class AprovarCandidatoUseCase {
  constructor(
    @inject('CandidaturaRepository') private repo: CandidaturaRepository,
    @inject('NotificacaoService') private notificacao: NotificacaoService,
    @inject('AuditoriaService') private auditoria: AuditoriaService
  ) {}
  
  async execute(candidatoId: string): Promise<Resultado> {
    // All business logic in domain
    const candidato = await this.repo.obterPorId(candidatoId);
    
    if (!candidato) {
      return { sucesso: false, erro: 'Candidato nao encontrado' };
    }
    
    if (candidato.status !== 'EM_ANALISE') {
      return { 
        sucesso: false, 
        erro: 'Somente candidatos em analise podem ser aprovados' 
      };
    }
    
    // Business orchestration
    await this.repo.atualizarStatus(candidatoId, 'APROVADO');
    await this.notificacao.enviar(candidato.email, 'Aprovado');
    await this.auditoria.registrar('APROVACAO', candidatoId);
    
    return { sucesso: true };
  }
}

// ✅ GOOD: Page is thin, delegates to domain
// src/presentation/pages/recrutamento/GestaoVagas.tsx
const GestaoVagasPage = () => {
  const container = useContainer();
  const aprovarUseCase = container.resolve(AprovarCandidatoUseCase);
  
  const handleAprovar = async (candidato: Candidato) => {
    const resultado = await aprovarUseCase.execute(candidato.id);
    
    if (resultado.sucesso) {
      toast.success('Candidato aprovado com sucesso');
    } else {
      toast.error(resultado.erro);
    }
  };
};
```

**Impact:**

- Bloated UI components - hard to test, hard to reuse
- Business logic scattered - can't find where decisions are made
- Testing difficulty - need to render components to test business rules
- Duplication - same calculations copied to multiple components

**Detection:**

- Business calculations (if/else logic on data) in `.tsx` files
- Components with > 100 lines (likely doing too much)
- Multiple API calls orchestrated in `handleSubmit`
- Date/number calculations in components
- Status determination logic in JSX

**Refactoring Strategy:**

| Violation | Move To |
|-----------|---------|
| Data transformation | `shared/utils` or Entity methods |
| Business validation | Domain UseCase or Entity |
| Orchestration (multiple API calls) | Domain UseCase |
| Status determination | Domain Entity or Value Object |
| Calculations | Domain Service |

