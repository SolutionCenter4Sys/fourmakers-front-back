              }
            },
            {
              "name": "Métricas (visão gestor — time)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "https://spw.app.foursys.com/backoffice-rf-hom/api/GestaoPessoa/Pdi/Metricas/gestor",
                "description": "Métricas agregadas do time. Response 200: ApiGenericResult<PdiMetricasResultDTO>"
              }
            },
            {
              "name": "Métricas (visão gestor — um colaborador)",
              "request": {
                "method": "GET",
                "header": [],
                "url": "https://spw.app.foursys.com/backoffice-rf-hom/api/GestaoPessoa/Pdi/Metricas/gestor/colaborador/{{colaboradorId}}",
                "description": "colaboradorId = codigo_interno (ex.: CPF). Response 200: PdiMetricasResultDTO; 400 se não pertence ao time."
              }
            }
          ]
        }
      ]
