{
  "name": "playwright-automation-project",
  "version": "1.0.0",
  "description": "Projeto de automação com Playwright e TypeScript — demo do módulo Reembolso",
  "scripts": {
    "demo": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 node scripts/run-versioned-demo.cjs",
    "demo:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 PLAYWRIGHT_SLOWMO=1500 node scripts/run-versioned-demo.cjs --headed",
    "demo:only": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 node scripts/run-versioned-demo.cjs",
    "demo:only:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 PLAYWRIGHT_SLOWMO=1500 node scripts/run-versioned-demo.cjs --headed",
    "test:solution-center:smoke": "playwright test --config=playwright.solution-center.config.ts",
    "test:bdd": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test tests/reembolso/reembolso-demo.spec.ts --reporter=list",
    "test:bdd:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 PLAYWRIGHT_SLOWMO=300 playwright test tests/reembolso/reembolso-demo.spec.ts --headed --reporter=list",
    "test": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test",
    "test:ui": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test --ui",
    "test:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test --headed",
    "test:reembolso": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test tests/reembolso/reembolso.spec.ts",
    "test:jornada": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test tests/reembolso/reembolso-jornada.spec.ts",
    "test:jornada:unico": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test tests/reembolso/reembolso-jornada-unico.spec.ts",
    "test:reembolso:all": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:8080 playwright test tests/reembolso/",
    "relatorio": "playwright show-report evidencias/relatorios",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.0.0"
  }
}
