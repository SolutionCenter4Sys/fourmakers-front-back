# Playwright E2E — variáveis locais (não commit)
# Copie para .env e ajuste. Preferir secrets no CI.
# Ambiente: HML (homolog) — backoffice-rf-hom

PLAYWRIGHT_BASE_URL=http://localhost:8080
PLAYWRIGHT_SLOWMO=150

# Reuso de sessão (default true) — evita EnviaToken a cada run
# Se JWT no storageState ainda for válido, OTP NÃO dispara (idade do arquivo não bloqueia).
E2E_REUSE_SESSION=true
E2E_REUSE_SESSION_MAX_AGE_MIN=30
# E2E_FORCE_AUTH=1

# OTP Solution Center (HML/QA)
OTP_API_BASE_URL=https://spw.app.foursys.com/backoffice-rf-hom
OTP_EMAIL=usuario_qa@foursys.com.br
OTP_ORG_ID=5
# OTP_SYSTEM_TOKEN=   # obrigatório em CI — nunca commit (ou use demo:preparar)

# Cache JWT (mint)
# BFF_TOKEN=
# BFF_FORCE_REFRESH=1
