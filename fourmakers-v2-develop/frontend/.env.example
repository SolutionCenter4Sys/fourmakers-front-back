VITE_API_FOURMAKERS_URL="https://sua-api.exemplo.com"
VITE_FLUTTERFLOW_BASE_URL="https://seu-app.exemplo.com"

# Firebase (configuração de cliente — obter no Console do Firebase)
VITE_FIREBASE_API_KEY="SUA_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000:web:000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Microsoft / Teams (MSAL)
VITE_MICROSOFT_CLIENT_ID="seu-client-id"
VITE_MICROSOFT_TENANT_ID="seu-tenant-id"
VITE_MICROSOFT_REDIRECT_URI="http://localhost:5173/"
