{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "homolog": "vite --mode homologation",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:homolog": "tsc -b && vite build --mode homologation",
    "build:hml": "npm run build:homolog",
    "preview:hml": "npm run build:hml && npm run preview:8080",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:5173": "sh -c '(lsof -ti :5173 | xargs kill -9) 2>/dev/null; exit 0' && vite preview --port 5173",
    "preview:8080": "sh -c '(lsof -ti :8080 | xargs kill -9) 2>/dev/null; exit 0' && vite preview --port 8080"
  },
